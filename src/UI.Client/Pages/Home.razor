                "/support?customer=northwind",
                "Tobias Berger",
                "/team/tobias",
                "EU West",
                24,
                [
                    new("INV-2026-014", "Januar 2026", 4320, "Bezahlt", [new("Business Seats", 86, 50)]),
                    new("INV-2026-015", "Februar 2026", 4320, "Mahnung", [new("Business Seats", 86, 50)])
                ]),
            new(
                "Contoso GmbH",
                "/customers/contoso",
                "Strategic Account",
                "Aktiv",
                "Enterprise Plus",
                41000,
                492000,
                512,
                3,
                "/support?customer=contoso",
                "Elena Novak",
                "/team/elena",
                "Global",
                3,
                [
                    new("INV-2026-021", "Januar 2026", 41000, "Bezahlt", [new("Enterprise Plus", 1, 41000)]),
