@page "/"
@using SoftwareThingies.KalBlazor.Core.DataGrid

@inject IJSRuntime JsRuntime

<main class="mx-auto max-w-7xl px-4 py-8">
    <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h1 class="text-2xl font-semibold text-slate-950">Dropdown styling demos</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-600">
            The root, panel, trigger, and indicator can all be styled or replaced while the panel remains fully custom.
        </p>

        <div class="mt-4 grid gap-6 md:grid-cols-3">
            <div>
                <div class="mb-2 text-sm font-medium text-slate-700">Panel and icon classes</div>
                <KalDropdown TriggerText="Account actions"
                             AdditionalClass="rounded-lg bg-slate-50 px-3 py-2"
                             PanelClass="absolute left-0 z-50 mt-3 w-72 rounded-xl border border-slate-700 bg-white p-2 text-slate-900 shadow-2xl"
                             IconClass="size-5 text-amber-500">
                    <ChildContent>@DropdownPanel</ChildContent>
                </KalDropdown>
            </div>
            <div>
                <div class="mb-2 text-sm font-medium text-slate-700">No indicator</div>
                <KalDropdown TriggerText="Account actions"
                             ShowIcon="false"
                             AdditionalClass="rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-sky-900"
                             PanelClass="absolute left-0 z-50 mt-2 w-64 rounded-md border border-sky-200 bg-white p-1 shadow-lg">
                    <ChildContent>
                        <div class="space-y-1 text-sm">
                            <a href="#" class="block rounded px-3 py-2 hover:bg-sky-50">View profile</a>
                            <a href="#" class="block rounded px-3 py-2 hover:bg-sky-50">Manage access</a>
                        </div>
                    </ChildContent>
                </KalDropdown>
            </div>
            <div>
                <div class="mb-2 text-sm font-medium text-slate-700">Custom trigger and icons</div>
                <KalDropdown AdditionalClass="rounded-xl bg-amber-100 px-4 py-3 text-amber-950"
                             PanelClass="absolute right-0 z-50 mt-2 w-72 rounded-xl border border-amber-200 bg-white p-3 shadow-xl"
                             OpenIcon="@Icons.X"
                             ClosedIcon="@Icons.Plus">
                    <TriggerTemplate>
                        <span class="flex items-center gap-2 font-semibold">
                            <KalIcon Icon="@Icons.Settings" AdditionalClass="size-4" />
                            Settings
                        </span>
                    </TriggerTemplate>
                    <ChildContent>@DropdownPanel</ChildContent>
                </KalDropdown>
            </div>
        </div>
    </section>

    <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-950">Button inside dropdown</h2>
        <p class="mt-2 text-sm text-slate-600">
            Click the button and check the browser console for the click handler output.
        </p>

        <div class="mt-4">
            <KalDropdown TriggerText="Open button demo"
                         AdditionalClass="rounded-md border border-violet-200 bg-violet-50 px-3 py-2 text-sm text-violet-900"
                         PanelClass="absolute left-0 z-50 mt-2 w-56 rounded-md border border-violet-200 bg-white p-2 shadow-lg">
                <ChildContent>
                    <button type="button"
                            class="w-full rounded px-3 py-2 text-left text-sm font-medium text-violet-900 hover:bg-violet-50"
                            @onclick="LogDropdownButtonClick">
                        Log button click
                    </button>
                </ChildContent>
            </KalDropdown>
        </div>
    </section>

    <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-950">Download panel example</h2>
        <p class="mt-2 text-sm text-slate-600">
            A compact grouped download menu built entirely with custom dropdown panel content.
        </p>

        <div class="mt-4">
            <KalDropdown AdditionalClass="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm"
                         PanelClass="absolute left-0 z-50 mt-2 w-[30rem] max-w-[calc(100vw-2rem)] rounded-lg border border-slate-300 bg-white p-2 shadow-xl">
                <TriggerTemplate>
                    <span class="flex items-center gap-2 font-medium">
                        Herunterladen
                    </span>
                </TriggerTemplate>
                <ChildContent>
                    <div class="text-xs text-slate-700">
                        <div class="pb-1 font-semibold uppercase tracking-wide text-slate-400">PDF-Downloads</div>
                        <div class="text-nowrap py-1">
                            <a href="#" class="flex items-center gap-2 rounded px-2 py-1.5 hover:bg-slate-50">
                                <KalIcon Icon="@Icons.PdfDocument" AdditionalClass="text-xl shrink-0 text-rose-500" />
                                <span class="min-w-0 flex-1 whitespace-nowrap">Abrechnungsdetails</span>
                                <span class="text-[0.65rem] text-slate-400">.pdf</span>
                            </a>
                            <a href="#" class="flex items-center gap-2 rounded px-2 py-1.5 hover:bg-slate-50">
                                <KalIcon Icon="@Icons.PdfDocument" AdditionalClass="text-xl shrink-0 text-rose-500" />
                                <span class="min-w-0 flex-1 whitespace-nowrap">Kontierungsblatt</span>
                                <span class="text-[0.65rem] text-slate-400">.pdf</span>
                            </a>
                            <a href="#" class="flex items-start gap-2 rounded px-2 py-1.5 hover:bg-slate-50">
                                <KalIcon Icon="@Icons.PdfDocument" AdditionalClass="text-xl shrink-0 text-rose-500" />
                                <span class="min-w-0 flex-1">
                                    <span class="block whitespace-nowrap font-semibold text-slate-800">Abrechnungsdetails + Leistungsnachweise</span>
                                    <span class="block whitespace-nowrap text-[0.65rem] text-slate-400">inkl. aller Leistungsnachweise</span>
                                </span>
                                <span class="text-[0.65rem] text-slate-400">.pdf</span>
                            </a>
                            <a href="#" class="flex items-start gap-2 rounded bg-slate-50 px-2 py-1.5 hover:bg-slate-100">
                                <KalIcon Icon="@Icons.PdfDocument" AdditionalClass="text-xl shrink-0 text-rose-500" />
                                <span class="min-w-0 flex-1">
                                    <span class="block whitespace-nowrap font-semibold text-slate-800">Abrechnungsdetails + Kontierungsblatt + LN</span>
                                    <span class="block whitespace-nowrap text-[0.65rem] text-slate-400">Detail + Kontierungsblatt + Leistungsnachweise</span>
                                </span>
                                <span class="text-[0.65rem] text-slate-400">.pdf</span>
                            </a>
                        </div>

                        <div class="mt-1 border-t border-slate-200 pt-1 font-semibold uppercase tracking-wide text-slate-400">Excel-Downloads</div>
                        <div class="text-nowrap py-1">
                            <a href="#" class="flex items-center gap-2 rounded px-2 py-1.5 hover:bg-slate-50">
                                <KalIcon Icon="@Icons.ExcelDocument" AdditionalClass="text-xl shrink-0 text-emerald-600" />
                                <span class="min-w-0 flex-1 whitespace-nowrap">Abrechnungsdetails</span>
                                <span class="text-[0.65rem] text-slate-400">.xlsx</span>
                            </a>
                            <a href="#" class="flex items-center gap-2 rounded px-2 py-1.5 hover:bg-slate-50">
                                <KalIcon Icon="@Icons.ExcelDocument" AdditionalClass="text-xl shrink-0 text-emerald-600" />
                                <span class="min-w-0 flex-1 whitespace-nowrap">Kontierungsblatt</span>
                                <span class="text-[0.65rem] text-slate-400">.xlsx</span>
                            </a>
                        </div>
                    </div>
                </ChildContent>
            </KalDropdown>
        </div>
    </section>

    <h1 class="mb-6 text-2xl font-semibold text-slate-950">KalDataGrid typed columns</h1>

    <section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="max-w-3xl">
                <h2 class="text-lg font-semibold text-slate-950">Tooltip examples</h2>
                <p class="mt-2 text-sm text-slate-600">
                    Tooltip examples now live directly on the home page and in the existing app bar above.
                </p>
                <p class="mt-2 text-sm text-slate-600">
                    Hover the drawer trigger, KalIcon sample, footer card, and grid surfaces to see the shared tooltip behavior and custom tooltip styles.
                </p>
            </div>

            <KalDrawerTrigger TargetId="home-tooltip-drawer"
                              Tooltip="@DrawerOpenTooltip">
                <span class="inline-flex rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    Tooltip-Drawer öffnen
                </span>
            </KalDrawerTrigger>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
            <KalFooterContent Class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-left"
                              Tooltip="@FooterTooltip"
                              TooltipClass="@OutlineTooltipClass">
                <div class="flex items-center gap-3 text-sm text-slate-700">
                    <KalIcon Icon="@Icons.Document"
                             AdditionalClass="text-xl text-amber-600"
                             Tooltip="@IconTooltip"
                             TooltipClass="@IceTooltipClass" />
                    <div>
                        <div class="font-medium text-slate-900">Content surface</div>
                        <div><code>KalFooterContent</code> and nested components can show shared tooltips without a separate demo page.</div>
                    </div>
                </div>
            </KalFooterContent>

            <div class="rounded-lg border border-dashed border-slate-300 bg-white p-4">
                <div class="text-sm font-medium text-slate-900">KalIcon demo</div>
                <p class="mt-2 text-sm text-slate-600">
                    These icons now render the shared tooltip attributes on their SVG root.
                </p>
                <div class="mt-4 flex items-center gap-4 text-slate-700">
                    <KalIcon Icon="@Icons.CircleInfo"
                             AdditionalClass="text-2xl text-sky-700"
                             Tooltip="@InfoIconTooltip"
                             TooltipClass="@IceTooltipClass" />
                    <KalIcon Icon="@Icons.Plus"
                             AdditionalClass="text-2xl text-emerald-700"
                             Tooltip="@AddIconTooltip"
                             TooltipClass="@SuccessTooltipClass" />
                    <KalIcon Icon="@Icons.X"
                             AdditionalClass="text-2xl text-rose-700"
                             Tooltip="@CloseIconTooltip"
                             TooltipClass="@OutlineTooltipClass" />
                </div>
            </div>
        </div>

        <div class="mt-6 rounded-xl border border-sky-200 bg-sky-50 p-5">
            <div class="max-w-3xl">
                <h3 class="text-base font-semibold text-sky-950">Touch tooltip demo</h3>
                <p class="mt-2 text-sm text-sky-900">
                    On phones and tablets, tap the cards below to open their tooltip. Tap the same card again or tap elsewhere to close it.
                </p>
            </div>

            <div class="mt-4 grid gap-3 sm:grid-cols-3">
                <div class="rounded-xl border border-sky-300 bg-white p-4 text-sm font-medium text-sky-950 shadow-sm"
                     data-kal-tooltip="@TouchStartTooltip"
                     data-kal-tooltip-class="@IceTooltipClass">
                    Tap target 1
                </div>
                <div class="rounded-xl border border-sky-300 bg-white p-4 text-sm font-medium text-sky-950 shadow-sm sm:text-center"
                     data-kal-tooltip="@TouchCenterTooltip"
                     data-kal-tooltip-class="@OutlineTooltipClass">
                    Tap target 2
                </div>
                <div class="rounded-xl border border-sky-300 bg-white p-4 text-sm font-medium text-sky-950 shadow-sm sm:text-right"
                     data-kal-tooltip="@TouchEndTooltip"
                     data-kal-tooltip-class="@SuccessTooltipClass">
                    Tap target 3
                </div>
            </div>
        </div>
    </section>

    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-slate-700">
        <div class="font-medium text-slate-900">ChildRow-Status testen</div>
        <p class="mt-1">
            Öffne eine oder mehrere Detailzeilen und klicke danach auf <strong>Daten neu erzeugen</strong>.
            Die Demo erstellt dabei bewusst neue Objektinstanzen, damit sich prüfen lässt, ob das Grid geöffnete Child Rows über Re-Renders hinweg behält.
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
            <button type="button"
                    class="inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                    @onclick="RecreateAccounts">
                Daten neu erzeugen
            </button>
            <button type="button"
                    class="inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                    @onclick="TriggerRerender">
                Nur Re-Render auslösen
            </button>
            <span class="text-xs text-slate-500">
                Reloads: @reloadCount · Re-Renders: @rerenderCount
            </span>
        </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-2">
        @RenderAccountGrid(
            "Ohne ItemKey",
            "Dieses Grid verliert geöffnete Child Rows, sobald neue Item-Instanzen gerendert werden.",
            AccountsWithoutItemKey,
            false)

        @RenderAccountGrid(
            "Mit ItemKey",
            "Dieses Grid behält geöffnete Child Rows auch dann, wenn dieselben Einträge als neue Instanzen neu gerendert werden.",
            AccountsWithItemKey,
            true)
    </div>
</main>

@code {
    private List<CustomerAccount> AccountsWithoutItemKey = CreateAccounts();
    private List<CustomerAccount> AccountsWithItemKey = CreateAccounts();
    private readonly IReadOnlyList<DropdownOption> DropdownOptions =
    [
        new("ACME Industries", "Enterprise account", "bg-emerald-500"),
        new("Northwind Traders", "Mid-market account", "bg-amber-500"),
        new("Fabrikam Logistics", "Growth account", "bg-rose-500")
    ];
    private int reloadCount;
    private int rerenderCount;

    private void RecreateAccounts()
    {
        AccountsWithoutItemKey = CreateAccounts();
        AccountsWithItemKey = CreateAccounts();
        reloadCount++;
    }

    private void TriggerRerender()
    {
        rerenderCount++;
    }

    private async Task LogDropdownButtonClick()
    {
        await JsRuntime.InvokeVoidAsync("console.log", "Dropdown button click handler fired.");
    }

    private static object? AccountItemKey(CustomerAccount account) => account.CustomerUrl;

    private static object? InvoiceItemKey(CustomerInvoice invoice) => invoice.Number;

    private RenderFragment DropdownPanel => @<div class="rounded-lg border border-slate-200 bg-white p-3 shadow-lg">
        <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Accounts</div>
        <div class="space-y-1">
            @foreach (var option in DropdownOptions)
            {
                <a href="#"
                   class="flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-slate-50">
                    <span>
                        <span class="block font-medium text-slate-900">@option.Name</span>
                        <span class="block text-xs text-slate-500">@option.Description</span>
                    </span>
                    <span class="size-2 shrink-0 rounded-full @option.StatusClass"></span>
                </a>
            }
        </div>
    </div>;

    private sealed record DropdownOption(string Name, string Description, string StatusClass);

    private RenderFragment RenderAccountGrid(string title, string description, IEnumerable<CustomerAccount> items, bool useItemKey) =>
        @<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <h2 class="text-lg font-semibold text-slate-950">@title</h2>
                        <p class="mt-1 text-sm text-slate-600">@description</p>
                    </div>
                    <span class="rounded-full px-3 py-1 text-xs font-medium @(useItemKey ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800")">
                        @(useItemKey ? "ItemKey aktiv" : "kein ItemKey")
                    </span>
                </div>
            </div>

            <div class="p-4">
                <KalDataGrid TItem="CustomerAccount"
                             Items="@items"
                             ItemKey="@(useItemKey ? AccountItemKey : null)"
                             AdditionalClass="my-2"
                             Tooltip="@GetGridTooltip(title)"
                             TooltipClass="@PanelTooltipClass">
                    <Filter>
                        <KalDataGridFilter Placeholder="Accounts filtern..." />
                    </Filter>

                    <Columns>
                        <KalToggleGridColumn TItem="CustomerAccount"
                                             HeaderClass="w-24 px-4 py-3"
                                             AdditionalHeaderClass="bg-slate-50 text-slate-900"
                                             CellClass="w-24 px-4 py-3 align-top">
                            <CellHeaderTemplate Context="toggle">
                                <button
                                    type="button"
                                    class="inline-flex items-center rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50"
                                    aria-expanded="@toggle.AreAllRowsExpanded"
                                    aria-label="@toggle.AriaLabel"
                                    @onclick="toggle.ToggleAsync">
                                    @(toggle.AreAllRowsExpanded ? "Alle zu" : "Alle auf")
                                </button>
                            </CellHeaderTemplate>
                            <CellTemplate Context="toggle">
                                <button
                                    type="button"
                                    class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-slate-300 bg-white text-sm font-semibold text-slate-700 hover:bg-amber-50 hover:text-amber-800"
                                    aria-expanded="@toggle.IsExpanded"
                                    aria-label="@toggle.AriaLabel"
                                    @onclick="toggle.ToggleAsync">
                                    @(toggle.IsExpanded ? "-" : "+")
                                </button>
                            </CellTemplate>
                        </KalToggleGridColumn>

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Kunde"
                                       Property="@(account => account.Name)"
                                       WidthClass="w-[18rem]"
                                       AdditionalHeaderClass="bg-amber-50 text-amber-900"
                                       Tooltip="@CustomerColumnTooltip"
                                       CellTooltip="GetCustomerTooltip"
                                       TooltipClass="@BrandTooltipClass">
                            <CellHeaderTemplate>
                                <div>Kunde</div>
                                <div class="text-[0.65rem] font-normal normal-case tracking-normal text-amber-700">
                                    Name und Segment
                                </div>
                            </CellHeaderTemplate>
                            <CellTemplate Context="account">
                                <a href="@account.CustomerUrl"
                                   class="font-semibold text-amber-700 hover:text-amber-900 hover:underline"
                                   title="Customer profile link">
                                    @account.Name
                                </a>
                                <div class="text-xs text-slate-500">@account.Segment</div>
                            </CellTemplate>
                            <CollapsedContent Context="account">
                                <div>Status: @account.Status</div>
                                <div>Plan: @account.Plan</div>
                                <div>Seats: @account.Seats</div>
                                <div>Tickets: <a href="@account.SupportUrl" class="text-amber-700 hover:underline">@account.OpenTickets offen</a></div>
                                <div>Owner: <a href="@account.OwnerUrl" class="text-amber-700 hover:underline">@account.Owner</a></div>
                                <div>Region: @account.Region</div>
                                <div>MRR: @account.MonthlyRecurringRevenue.ToString("N0") EUR</div>
                                <div>ARR: @account.AnnualRecurringRevenue.ToString("N0") EUR</div>
                                <div>Churn Risk: @account.ChurnRiskPercent%</div>
                            </CollapsedContent>
                        </KalGridColumn>

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Status"
                                       Property="@(account => account.Status)"
                                       CollapseBelow="KalDataGridBreakpoint.Md"
                                       AdditionalHeaderClass="bg-amber-50 text-amber-900"
                                       Tooltip="@StatusColumnTooltip"
                                       CellTooltip="GetStatusTooltip"
                                       TooltipClass="@OutlineTooltipClass">
                            <CellTemplate Context="account">
                                <span class="@GetStatusClass(account.Status)"
                                      title="Status badge">
                                    @account.Status
                                </span>
                            </CellTemplate>
                        </KalGridColumn>

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Plan"
                                       Property="@(account => account.Plan)"
                                       CollapseBelow="KalDataGridBreakpoint.Lg"
                                       Tooltip="@PlanColumnTooltip"
                                       CellTooltip="GetPlanTooltip" />

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="MRR"
                                       Property="@(account => account.MonthlyRecurringRevenue)"
                                       Alignment="KalDataGridAlignment.End"
                                       Tooltip="@MrrColumnTooltip"
                                       CellTooltip="GetMrrTooltip">
                            <CellTemplate Context="account">
                                @account.MonthlyRecurringRevenue.ToString("N0") EUR
                            </CellTemplate>
                        </KalGridColumn>

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Seats"
                                       Property="@(account => account.Seats)"
                                       Alignment="KalDataGridAlignment.End"
                                       CollapseBelow="KalDataGridBreakpoint.Md"
                                       Tooltip="@SeatsColumnTooltip"
                                       CellTooltip="GetSeatsTooltip" />

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Tickets"
                                       Property="@(account => account.OpenTickets)"
                                       Alignment="KalDataGridAlignment.End"
                                       CollapseBelow="KalDataGridBreakpoint.Lg"
                                       Tooltip="@TicketsColumnTooltip"
                                       CellTooltip="GetTicketsTooltip"
                                       TooltipClass="@IceTooltipClass">
                            <CellTemplate Context="account">
                                <a href="@account.SupportUrl" class="text-amber-700 hover:underline">
                                    @account.OpenTickets
                                </a>
                            </CellTemplate>
                        </KalGridColumn>

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Owner"
                                       Property="@(account => account.Owner)"
                                       CollapseBelow="KalDataGridBreakpoint.Xl"
                                       Tooltip="@OwnerColumnTooltip"
                                       CellTooltip="GetOwnerTooltip"
                                       TooltipClass="@SuccessTooltipClass">
                            <CellTemplate Context="account">
                                <a href="@account.OwnerUrl" class="text-amber-700 hover:underline">
                                    @account.Owner
                                </a>
                            </CellTemplate>
                        </KalGridColumn>

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Region"
                                       Property="@(account => account.Region)"
                                       CollapseBelow="KalDataGridBreakpoint.Xl"
                                       Tooltip="@RegionColumnTooltip"
                                       CellTooltip="GetRegionTooltip" />

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="ARR"
                                       Property="@(account => account.AnnualRecurringRevenue)"
                                       Alignment="KalDataGridAlignment.End"
                                       CollapseBelow="KalDataGridBreakpoint.TwoXl"
                                       Tooltip="@ArrColumnTooltip"
                                       CellTooltip="GetArrTooltip">
                            <CellTemplate Context="account">
                                @account.AnnualRecurringRevenue.ToString("N0") EUR
                            </CellTemplate>
                        </KalGridColumn>

                        <KalGridColumn TItem="CustomerAccount"
                                       Title="Churn Risk"
                                       Property="@(account => account.ChurnRiskPercent)"
                                       Alignment="KalDataGridAlignment.End"
                                       CollapseBelow="KalDataGridBreakpoint.TwoXl"
                                       Tooltip="@ChurnRiskColumnTooltip"
                                       CellTooltip="GetChurnRiskTooltip">
                            <CellTemplate Context="account">
                                @account.ChurnRiskPercent%
                            </CellTemplate>
                        </KalGridColumn>
                    </Columns>

                    <ChildRowContent Context="account">
                        <KalDataGrid TItem="CustomerInvoice"
                                     Items="@account.Invoices"
                                     ItemKey="@(useItemKey ? InvoiceItemKey : null)"
                                     Tooltip="@GetInvoiceGridTooltip(account)"
                                     TooltipClass="@OutlineTooltipClass"
                                     TableClass="w-full min-w-full border-collapse text-xs"
                                     HeaderClass="bg-slate-100"
                                     BodyClass="divide-y divide-slate-200"
                                     RowClass="transition-colors hover:bg-slate-50">
                            <Columns>
                                <KalGridColumn TItem="CustomerInvoice"
                                               Title="Rechnung"
                                               Property="@(invoice => invoice.Number)"
                                               Tooltip="@InvoiceNumberColumnTooltip"
                                               CellTooltip="GetInvoiceNumberTooltip" />
                                <KalGridColumn TItem="CustomerInvoice"
                                               Title="Zeitraum"
                                               Property="@(invoice => invoice.Period)"
                                               CollapseBelow="KalDataGridBreakpoint.Md"
                                               Tooltip="@InvoicePeriodColumnTooltip"
                                               CellTooltip="GetInvoicePeriodTooltip" />
                                <KalGridColumn TItem="CustomerInvoice"
                                               Title="Betrag"
                                               Property="@(invoice => invoice.Amount)"
                                               Alignment="KalDataGridAlignment.End"
                                               Tooltip="@InvoiceAmountColumnTooltip"
                                               CellTooltip="GetInvoiceAmountTooltip">
                                    <CellTemplate Context="invoice">
                                        @invoice.Amount.ToString("N0") EUR
                                    </CellTemplate>
                                </KalGridColumn>
                                <KalGridColumn TItem="CustomerInvoice"
                                               Title="Status"
                                               Property="@(invoice => invoice.Status)"
                                               Alignment="KalDataGridAlignment.End"
                                               Tooltip="@InvoiceStatusColumnTooltip"
                                               CellTooltip="GetInvoiceStatusTooltip">
                                    <CellTemplate Context="invoice">
                                        <span class="@GetInvoiceStatusClass(invoice.Status)">@invoice.Status</span>
                                    </CellTemplate>
                                </KalGridColumn>
                            </Columns>

                            <ChildRowContent Context="invoice">
                                <div class="grid gap-2 text-xs text-slate-600 md:grid-cols-2">
                                    @foreach (var line in invoice.Lines)
                                    {
                                        <div class="rounded-md border border-slate-200 bg-white px-3 py-2">
                                            <div class="font-medium text-slate-900">@line.Description</div>
                                            <div>@line.Quantity x @line.UnitPrice.ToString("N0") EUR</div>
                                        </div>
                                    }
                                </div>
                            </ChildRowContent>
                        </KalDataGrid>
                    </ChildRowContent>
                </KalDataGrid>
            </div>
        </section>;

