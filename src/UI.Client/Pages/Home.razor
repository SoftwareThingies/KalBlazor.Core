    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Aktiv" => "rounded-full bg-emerald-100 px-2 py-1 text-xs font-medium text-emerald-700",
            "Review" => "rounded-full bg-yellow-100 px-2 py-1 text-xs font-medium text-yellow-800",
            _ => "rounded-full bg-rose-100 px-2 py-1 text-xs font-medium text-rose-700"
        };
    }

    private static string GetInvoiceStatusClass(string status)
    {
        return status switch
        {
            "Bezahlt" => "rounded-full bg-emerald-100 px-2 py-1 text-xs font-medium text-emerald-700",
            "Offen" => "rounded-full bg-sky-100 px-2 py-1 text-xs font-medium text-sky-700",
            _ => "rounded-full bg-rose-100 px-2 py-1 text-xs font-medium text-rose-700"
        };
    }

    private sealed record CustomerAccount(
        string Name,
        string CustomerUrl,
        string Segment,
        string Status,
        string Plan,
        decimal MonthlyRecurringRevenue,
        decimal AnnualRecurringRevenue,
        int Seats,
        int OpenTickets,
        string SupportUrl,
        string Owner,
        string OwnerUrl,
        string Region,
        int ChurnRiskPercent,
        IReadOnlyList<CustomerInvoice> Invoices);

    private sealed record CustomerInvoice(
        string Number,
        string Period,
        decimal Amount,
        string Status,
        IReadOnlyList<CustomerInvoiceLine> Lines);

    private sealed record CustomerInvoiceLine(
        string Description,
        int Quantity,
        decimal UnitPrice);
}

<KalDrawer Id="home-tooltip-drawer"
           InitialState="KalDrawerState.Hidden"
           Width="DrawerWidth.Md"
           Tooltip="@DrawerTooltip"
           TooltipClass="@PanelTooltipClass">
    <ChildContent Context="drawer">
        <KalDrawerHeader Tooltip="@DrawerHeaderTooltip"
                         TooltipClass="@BrandTooltipClass">
            <div class="flex items-center justify-between gap-3">
                <span class="font-medium text-slate-900">Tooltip example drawer</span>
                <KalDrawerTrigger TargetId="home-tooltip-drawer"
                                  Action="KalDrawerTriggerAction.Close"
                                  AdditionalClass="rounded p-2 hover:bg-slate-100"
                                  Tooltip="@DrawerCloseTooltip"
                                  TooltipClass="@OutlineTooltipClass">
                    <KalIcon Icon="@Icons.X" />
                </KalDrawerTrigger>
            </div>
        </KalDrawerHeader>

        <KalDrawerContent Tooltip="@DrawerContentTooltip"
                          TooltipClass="@PanelTooltipClass">
            <div class="space-y-3 text-sm text-slate-700">
                <p>
                    This drawer keeps one interactive tooltip example on the home page without needing a dedicated tooltip route.
                </p>
                <KalDrawerTrigger TargetId="home-tooltip-drawer"
                                  Action="KalDrawerTriggerAction.Close"
                                  Tooltip="@DrawerCloseTooltip"
                                  TooltipClass="@SuccessTooltipClass">
                    <span class="inline-flex rounded-md bg-slate-900 px-3 py-2 font-medium text-white hover:bg-slate-700">
                        Drawer schließen
                    </span>
                </KalDrawerTrigger>
            </div>
        </KalDrawerContent>
    </ChildContent>
</KalDrawer>
