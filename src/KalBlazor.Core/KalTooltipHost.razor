@namespace SoftwareThingies.KalBlazor.Core
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

@if (IsVisible && !string.IsNullOrWhiteSpace(TooltipText))
{
    <div class="@TooltipCssClass"
         role="tooltip"
         aria-hidden="false"
         style="@TooltipStyle">
        @TooltipText
    </div>
}

@code {
    private const double OffsetX = 16;
    private const double OffsetY = 20;
    private const string TooltipBaseClass = "fixed left-0 top-0 z-[2147483647] max-w-[min(24rem,calc(100vw-1rem))] whitespace-pre-line break-words pointer-events-none [transform:translate3d(0,0,0)] transition-opacity duration-75 ease-out";
    private const string TooltipDefaultClass = "rounded-lg border border-transparent bg-slate-950/95 px-3 py-2 text-sm font-medium leading-5 text-slate-50 shadow-xl";

    private DotNetObjectReference<KalTooltipHost>? _dotNetReference;
    private IJSObjectReference? _module;
    private bool IsVisible { get; set; }
    private string? TooltipText { get; set; }
    private string? TooltipClass { get; set; }
    private double ClientX { get; set; }
    private double ClientY { get; set; }

    private string TooltipCssClass =>
        $"{TooltipBaseClass} {(string.IsNullOrWhiteSpace(TooltipClass) ? TooltipDefaultClass : TooltipClass)}".Trim();

    private string TooltipStyle =>
        $"left:{(ClientX + OffsetX).ToString(System.Globalization.CultureInfo.InvariantCulture)}px;top:{(ClientY + OffsetY).ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/SoftwareThingies.KalBlazor.Core/kalTooltip.js");

        _dotNetReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("initializeKalTooltips", _dotNetReference);
    }

    [JSInvokable]
    public Task ShowTooltip(string tooltipText, string? tooltipClass, double clientX, double clientY)
    {
        SetTooltipState(tooltipText, tooltipClass, clientX, clientY);

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task UpdateTooltipPosition(double clientX, double clientY)
    {
        if (!IsVisible)
        {
            return Task.CompletedTask;
        }

        SetTooltipPosition(clientX, clientY);

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task HideTooltip()
    {
        if (!IsVisible && string.IsNullOrWhiteSpace(TooltipText))
        {
            return Task.CompletedTask;
        }

        ClearTooltipState();

        return InvokeAsync(StateHasChanged);
    }

    private void SetTooltipState(string tooltipText, string? tooltipClass, double clientX, double clientY)
    {
        TooltipText = tooltipText;
        TooltipClass = tooltipClass;
        SetTooltipPosition(clientX, clientY);
        IsVisible = !string.IsNullOrWhiteSpace(tooltipText);
    }

    private void SetTooltipPosition(double clientX, double clientY)
    {
        ClientX = clientX;
        ClientY = clientY;
    }

    private void ClearTooltipState()
    {
        IsVisible = false;
        TooltipText = null;
        TooltipClass = null;
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetReference?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeKalTooltips");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The Blazor Server circuit can disconnect before JS module disposal runs.
            }
        }
    }
}
