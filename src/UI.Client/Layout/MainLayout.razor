@inherits LayoutComponentBase

@* <KalThemeBootstrap /> *@

<KalLayout>
    <KalAppBar Fixed
               Tooltip="@AppBarTooltip"
               TooltipClass="@TooltipBrandClass">
        <KalAppBarToggle HorizontalAlignment="KalHorizontalAlignment.Right"
                         Tooltip="@AppBarToggleTooltip"
                         TooltipClass="@TooltipOutlineClass" />
        <KalCollapsible HorizontalAlignment="KalHorizontalAlignment.Left"
                        Tooltip="@CollapsibleTooltip"
                        TooltipClass="@TooltipPanelClass">
            <div>Test 1</div>
            <div>Test 2</div>
            <div>Test 3</div>
            <div>Test 4</div>
            <KalDrawerTrigger TargetId="left-menu"
                              Tooltip="@LeftDrawerTriggerTooltip"
                              TooltipClass="@TooltipOutlineClass">
                Links öffnen
            </KalDrawerTrigger>
    
            <KalDrawerTrigger TargetName="right-menu"
                              Tooltip="@RightDrawerTriggerTooltip"
                              TooltipClass="@TooltipPanelClass">
                Rechts öffnen
            </KalDrawerTrigger>
    
            <KalThemeToggle Tooltip="@ThemeToggleTooltip"
                            TooltipClass="@TooltipSuccessClass">
                Dark Mode
            </KalThemeToggle>
        </KalCollapsible>
    </KalAppBar>
    
    <KalDrawer Id="left-menu"
               Variant="KalDrawerVariant.Docked"
               Backdrop="@_leftDrawerBackdrop"
               Minimizable
               ShowDefaultTrigger="false"
               @bind-InitialState="_leftDrawerState"
               @bind-MinimizeOnClose="_minimizeLeftDrawerOnClose"
               @bind-ExpandOnHover="_expandLeftDrawerOnHover"
               @bind-CollapseOnMouseLeave="_collapseLeftDrawerOnMouseLeave"
               ExpandOnHoverDelay="@_expandOnHoverDelay"
               CollapseOnMouseLeaveDelay="@_collapseOnMouseLeaveDelay"
               PreventClose="@_preventLeftDrawerClose"
               OnClosed="HandleLeftDrawerClosed"
               OnOpened="HandleLeftDrawerOpened"
               OnClosedAsync="HandleLeftDrawerClosedAsync"
               OnOpenedAsync="HandleLeftDrawerOpenedAsync">
        <ChildContent Context="drawer">
            <KalDrawerHeader AdditionalClass="flex items-center justify-between gap-2">
                <KalDrawerMinimizerTrigger AdditionalClass="rounded p-2 hover:bg-slate-100">
                    <KalIcon Icon="@Icons.AngleLeft" />
                </KalDrawerMinimizerTrigger>
                <KalDrawerMaximizerTrigger AdditionalClass="rounded p-2 hover:bg-slate-100">
                    <KalIcon Icon="@Icons.Bars" />
                </KalDrawerMaximizerTrigger>
                <span>Header: @drawer.State</span>
            </KalDrawerHeader>
            <KalDrawerContent>
                <div class="mb-6 flex flex-col gap-3 border-b border-slate-200 pb-6">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="_preventLeftDrawerClose"/>
                        Schließen verhindern
                    </label>

                    <label class="flex flex-col gap-1">
                        <span>Drawer-Zustand</span>
                        <select class="rounded border border-slate-300 px-2 py-1"
                                @bind="_leftDrawerState">
                            <option value="@KalDrawerState.Hidden">Hidden</option>
                            <option value="@KalDrawerState.Minimized">Minimized</option>
                            <option value="@KalDrawerState.Maximized">Maximized</option>
                        </select>
                    </label>

                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="_minimizeLeftDrawerOnClose"/>
                        Beim Schließen minimieren
                    </label>

                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="_expandLeftDrawerOnHover"/>
                        Beim Darüberfahren erweitern
                    </label>

                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="_collapseLeftDrawerOnMouseLeave"/>
                        Nach Hover wieder schließen
                    </label>

                    <label class="flex flex-col gap-1">
                        <span>Hover-Verzögerung in Millisekunden</span>
                        <input type="number"
                               min="0"
                               class="rounded border border-slate-300 px-2 py-1"
                               @bind="_expandOnHoverDelay"/>
                    </label>

                    <label class="flex flex-col gap-1">
                        <span>Verzögerung beim Verlassen in Millisekunden</span>
                        <input type="number"
                               min="0"
                               class="rounded border border-slate-300 px-2 py-1"
                               @bind="_collapseOnMouseLeaveDelay"/>
                    </label>

                    <label class="flex flex-col gap-1">
                        <span>Hintergrund</span>
                        <select class="rounded border border-slate-300 px-2 py-1"
                                @bind="_leftDrawerBackdrop">
                            <option value="@KalDrawerBackdrop.Darkened">Verdunkelt</option>
                            <option value="@KalDrawerBackdrop.Transparent">Transparent</option>
                            <option value="@KalDrawerBackdrop.None">Deaktiviert</option>
                        </select>
                    </label>

                    <KalDrawerTrigger TargetId="left-menu"
                                      Action="KalDrawerTriggerAction.Close"
                                      AdditionalClass="rounded bg-slate-200 px-3 py-2">
                        Drawer schließen
                    </KalDrawerTrigger>
                    @if (_leftDrawerClosed)
                    {
                        <span class="text-sm text-slate-600">OnClosed wurde ausgelöst.</span>
                    }
                    @if (_leftDrawerOpened)
                    {
                        <span class="text-sm text-slate-600">OnOpened wurde ausgelöst.</span>
                    }
                    @if (_leftDrawerClosedAsync)
                    {
                        <span class="text-sm text-slate-600">OnClosedAsync wurde ausgelöst.</span>
                    }
                    @if (_leftDrawerOpenedAsync)
                    {
                        <span class="text-sm text-slate-600">OnOpenedAsync wurde ausgelöst.</span>
                    }
                </div>

                <div class="flex flex-col gap-3 text-slate-700 p-3">
                    @foreach (var (icon, label) in DrawerIconExamples)
                    {
                        var iconClass = icon == Icons.X ? "text-xl border-4" : "text-xl border-2";
                        <div class="flex items-center gap-3">
                            <KalIcon Icon="@icon" AdditionalClass="@($"{iconClass} stroke-current")" />
                            @if (!drawer.IsMinimized)
                            {
                                <KalIcon Icon="@icon"
                                         Class="inline-block shrink-0 overflow-visible align-middle stroke-current fill-sky-500"
                                         AdditionalClass="@iconClass"
                                         AriaLabel="@($"{label} (fill-sky-500)")" title="fill-sky-500" />
                                <span class="text-xl">@label</span>
                            }
                        </div>
                    }
                </div>
            </KalDrawerContent>
            <KalDrawerFooter>Footer</KalDrawerFooter>
        </ChildContent>
    </KalDrawer>

    <KalDrawer Name="right-menu" InitialState="KalDrawerState.Hidden" Side="KalDrawerSide.Right" Variant="KalDrawerVariant.Clipped">
        Rechts
    </KalDrawer>

    <KalAppMainContent>
        @Body
        <KalFooterContent>
            <div>Footer content</div>
        </KalFooterContent>
    </KalAppMainContent>
</KalLayout>  

@code {
    private static readonly (string Icon, string Label)[] DrawerIconExamples =
    [
        (Icons.AngleDown, "Angle Down"),
        (Icons.AngleLeft, "Angle Left"),
        (Icons.AngleRight, "Angle Right"),
        (Icons.AngleUp, "Angle Up"),
        (Icons.ArrowDown, "Arrow Down"),
        (Icons.ArrowLeft, "Arrow Left"),
        (Icons.ArrowRight, "Arrow Right"),
        (Icons.ArrowUp, "Arrow Up"),
        (Icons.Bars, "Bars"),
        (Icons.Camera, "Camera"),
        (Icons.Check, "Check"),
        (Icons.Clapperboard, "Clapperboard"),
        (Icons.Clock, "Clock"),
        (Icons.Company, "Company"),
        (Icons.Contact, "Contact"),
        (Icons.CircleInfo, "Circle Info"),
        (Icons.Document, "Document"),
        (Icons.Download, "Download"),
        (Icons.Email, "Email"),
        (Icons.Eye, "Eye"),
        (Icons.EllipsisVertical, "Ellipsis Vertical"),
        (Icons.ExcelDocument, "Excel Document"),
        (Icons.ExcelBasic, "Excel Document (basic)"),
        (Icons.ExclamationCircle, "Exclamation Circle"),
        (Icons.FileArrowUp, "File Arrow Up"),
        (Icons.FileInvoiceEuro, "File Invoice Euro"),
        (Icons.FileLines, "File Lines"),
        (Icons.FilePencil, "File Pencil"),
        (Icons.FileSignature, "File Signature"),
        (Icons.FileStamp, "File Stamp"),
        (Icons.Lock, "Lock"),
        (Icons.LockOpen, "Lock Open"),
        (Icons.LocationPin, "Location Pin"),
        (Icons.Filter, "Filter"),
        (Icons.Graph, "Graph"),
        (Icons.Minus, "Minus"),
        (Icons.Microphone, "Microphone"),
        (Icons.Pencil, "Pencil"),
        (Icons.PdfDocument, "Pdf Document"),
        (Icons.PdfBasic, "Pdf Document (basic)"),
        (Icons.Phone, "Phone"),
        (Icons.Plus, "Plus"),
        (Icons.Printer, "Printer"),
        (Icons.QuestionCircle, "Question Circle"),
        (Icons.Search, "Search"),
        (Icons.Settings, "Settings"),
        (Icons.TableCells, "Table Cells"),
        (Icons.Trash, "Trash"),
        (Icons.TriangleExclamation, "Triangle Exclamation"),
        (Icons.UserKey, "User Key"),
        (Icons.UserPen, "User Pen"),
        (Icons.Users, "Users"),
        (Icons.VideoCamera, "Video Camera"),
        (Icons.X, "X"),
        (Icons.ZipDocument, "Zip Document"),
        (Icons.ZipBasic, "Zip Document (basic)"),
    ];

    private const string TooltipBrandClass = "max-w-md rounded-xl border border-white/25 bg-gradient-to-br from-red-900 to-amber-700 px-3 py-2 text-sm font-bold leading-5 text-white shadow-2xl";
    private const string TooltipPanelClass = "max-w-md rounded-2xl border border-slate-600 bg-slate-950/95 px-4 py-3 text-sm font-medium leading-5 text-slate-50 shadow-2xl";
    private const string TooltipSuccessClass = "max-w-md rounded-xl border border-emerald-300 bg-emerald-900/95 px-3 py-2 text-sm font-semibold leading-5 text-emerald-50 shadow-xl";
    private const string TooltipOutlineClass = "max-w-md rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold leading-5 text-slate-950 shadow-xl";
    private const string AppBarTooltip = "KalAppBar\nThe existing app bar now hosts the navigation tooltip examples.";
    private const string AppBarToggleTooltip = "KalAppBarToggle\nToggles the collapsible navigation in the app bar.";
    private const string CollapsibleTooltip = "KalCollapsible\nThe navigation container also participates in the shared tooltip system.";
    private const string LeftDrawerTriggerTooltip = "KalDrawerTrigger\nOpens the left drawer from the existing app bar.";
    private const string RightDrawerTriggerTooltip = "KalDrawerTrigger\nOpens the right drawer from the existing app bar.";
    private const string ThemeToggleTooltip = "KalThemeToggle\nSwitch between light and dark mode.";
    private KalDrawerBackdrop _leftDrawerBackdrop = KalDrawerBackdrop.Darkened;
    private KalDrawerState _leftDrawerState = KalDrawerState.Maximized;
    private bool _preventLeftDrawerClose;
    private bool _minimizeLeftDrawerOnClose;
    private bool _expandLeftDrawerOnHover = true;
    private bool _collapseLeftDrawerOnMouseLeave = true;
    private bool _leftDrawerClosed;
    private bool _leftDrawerOpened;
    private bool _leftDrawerClosedAsync;
    private bool _leftDrawerOpenedAsync;
    private int _expandOnHoverDelay = 500;
    private int _collapseOnMouseLeaveDelay = 300;

    private void HandleLeftDrawerClosed()
    {
        _leftDrawerClosed = true;
    }

    private void HandleLeftDrawerOpened()
    {
        _leftDrawerOpened = true;
    }

    private Task HandleLeftDrawerClosedAsync()
    {
        _leftDrawerClosedAsync = true;
        return Task.CompletedTask;
    }

    private Task HandleLeftDrawerOpenedAsync()
    {
        _leftDrawerOpenedAsync = true;
        return Task.CompletedTask;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
